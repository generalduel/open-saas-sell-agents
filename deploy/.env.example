# deploy/.env - production settings for app.my2ndworkforce.com
# setup-vps.sh copies this file to deploy/.env and fills the GENERATED values.
# Fill every "FILL_ME" yourself on the VPS. Never commit deploy/.env.

# ---- Domains / TLS ----
# Canonical site, plus hostnames that 301-redirect to it (comma-separated)
APP_DOMAIN=www.my2ndworkforce.com
REDIRECT_DOMAINS=my2ndworkforce.com, app.my2ndworkforce.com
API_DOMAIN=api.my2ndworkforce.com
ACME_EMAIL=support@my2ndworkforce.com

# ---- Database (container-internal, GENERATED) ----
POSTGRES_DB=opensaas
POSTGRES_USER=opensaas_app
POSTGRES_PASSWORD=GENERATED

# ---- Wasp core (GENERATED) ----
JWT_SECRET=GENERATED
ADMIN_EMAILS=support@my2ndworkforce.com

# ---- Email: SMTP (sender support@my2ndworkforce.com must be allowed by this mailbox) ----
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=support@my2ndworkforce.com
SMTP_PASSWORD=FILL_ME

# ---- Google login + Portal Google Sync ----
GOOGLE_CLIENT_ID=FILL_ME
GOOGLE_CLIENT_SECRET=FILL_ME
GOOGLE_SYNC_REDIRECT_URI=https://api.my2ndworkforce.com/portal/google/callback

# ---- Stripe (active payment processor) ----
STRIPE_API_KEY=FILL_ME
STRIPE_WEBHOOK_SECRET=FILL_ME
PAYMENTS_HOBBY_SUBSCRIPTION_PLAN_ID=FILL_ME
PAYMENTS_PRO_SUBSCRIPTION_PLAN_ID=FILL_ME
PAYMENTS_CREDITS_10_PLAN_ID=FILL_ME

# ---- Portal ----
PORTAL_ENCRYPTION_KEY=GENERATED
N8N_BASE_URL=
N8N_API_KEY=
N8N_AGENT_WEBHOOK_URL=
N8N_DECISION_WEBHOOK_URL=
N8N_WEBHOOK_SHARED_SECRET=GENERATED

# ---- Unused integrations: the template constructs these SDK clients at startup,
# ---- so they need non-empty placeholders. Replace with real values to enable a feature.
OPENAI_API_KEY=not-configured
LEMONSQUEEZY_API_KEY=not-configured
LEMONSQUEEZY_STORE_ID=not-configured
LEMONSQUEEZY_WEBHOOK_SECRET=not-configured
POLAR_ORGANIZATION_ACCESS_TOKEN=not-configured
POLAR_WEBHOOK_SECRET=not-configured
POLAR_SANDBOX_MODE=false
PLAUSIBLE_API_KEY=not-configured
PLAUSIBLE_SITE_ID=not-configured
PLAUSIBLE_BASE_URL=https://plausible.io/api
GOOGLE_ANALYTICS_CLIENT_EMAIL=not-configured
GOOGLE_ANALYTICS_PRIVATE_KEY=not-configured
GOOGLE_ANALYTICS_PROPERTY_ID=not-configured
AWS_S3_IAM_ACCESS_KEY=not-configured
AWS_S3_IAM_SECRET_KEY=not-configured
AWS_S3_FILES_BUCKET=not-configured
AWS_S3_REGION=us-east-1

# ---- Client build-time (baked into the frontend) ----
REACT_APP_GOOGLE_ANALYTICS_ID=
