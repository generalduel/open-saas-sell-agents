datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  email                     String?         @unique
  username                  String?         @unique
  isAdmin                   Boolean         @default(false)

  paymentProcessorUserId    String?         @unique
  lemonSqueezyCustomerPortalUrl String?     // You can delete this if you're not using Lemon Squeezy as your payments processor.
  subscriptionStatus        String?         // 'active', 'cancel_at_period_end', 'past_due', 'deleted'
  subscriptionPlan          String?         // 'hobby', 'pro'
  datePaid                  DateTime?
  credits                   Int             @default(3)

  gptResponses              GptResponse[]
  contactFormMessages       ContactFormMessage[]
  tasks                     Task[]
  files                     File[]
  agentConfigs              PortalAgentConfig[]
  portalCredentials         PortalCredential[]
  portalReviews             PortalReview[]
  googleConnections         PortalGoogleConnection[]
  googleOAuthStates         PortalGoogleOAuthState[]
  agentEntitlements         CustomerAgentEntitlement[]
  agentCredentialLinks      CustomerAgentCredential[]
}

model GptResponse {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
}

model Task {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  description               String
  time                      String          @default("1")
  isDone                    Boolean         @default(false)
}

model File {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  name                      String
  type                      String
  s3Key                     String
}

model DailyStats {
  id                               Int             @id @default(autoincrement())
  date                             DateTime        @default(now()) @unique

  totalViews                       Int             @default(0)
  prevDayViewsChangePercent        String          @default("0")
  userCount                        Int             @default(0)
  paidUserCount                    Int             @default(0)
  userDelta                        Int             @default(0)
  paidUserDelta                    Int             @default(0)
  totalRevenue                     Float           @default(0)
  totalProfit                      Float           @default(0)

  sources                          PageViewSource[]
}

model PageViewSource {
  @@id([date, name])
  name                     String
  date                     DateTime        @default(now())

  dailyStats               DailyStats?     @relation(fields: [dailyStatsId], references: [id])
  dailyStatsId             Int?

  visitors                 Int
}

model Logs {
  id                       Int             @id @default(autoincrement())
  createdAt                DateTime        @default(now())

  message                  String
  level                    String
}

model ContactFormMessage {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
  isRead                    Boolean         @default(false)
  repliedAt                 DateTime?
}

model PortalAgentConfig {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug String
  active Boolean @default(false)
  parameters Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, slug])
  @@index([userId, active])
}
model PortalCredential {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String
  ciphertext String @db.Text
  iv String
  tag String
  keyVersion Int @default(1)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@unique([userId, provider])
}
model PortalGoogleConnection {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleSubject String?
  scopes String[]
  encryptedRefreshToken String? @db.Text
  tokenIv String?
  tokenTag String?
  keyVersion Int @default(1)
  connectedAt DateTime?
  updatedAt DateTime @updatedAt
  @@unique([userId])
}
model PortalReview {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflowId String
  executionId String
  title String
  summary String @db.Text
  proposedAction Json
  status String @default("pending")
  decisionId String? @unique
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, status])
  @@unique([userId, executionId])
}

model PortalGoogleOAuthState {
 id String @id @default(uuid())
 userId String
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 verifierCiphertext String @db.Text
 verifierIv String
 verifierTag String
 expiresAt DateTime
 consumedAt DateTime?
 createdAt DateTime @default(now())
 @@index([userId,expiresAt])
}

model CustomerAgentEntitlement {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  agentSlug String
  n8nProjectId String
  workflowId String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([userId,agentSlug])
  @@index([n8nProjectId])
}
model CustomerAgentCredential {
  id String @id @default(uuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  entitlementId String
  service String
  n8nCredentialId String?
  n8nCredentialType String
  encryptedData String @db.Text
  iv String
  tag String
  keyVersion Int @default(1)
  status String @default("pending")
  lastError String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@unique([entitlementId,service])
  @@index([userId])
}
