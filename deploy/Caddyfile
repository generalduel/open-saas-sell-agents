{
	email {$ACME_EMAIL}
}

# Frontend (landing page, login, /portal ...) - SPA with 200.html fallback
{$APP_DOMAIN} {
	encode zstd gzip
	root * /srv
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /200.html
	file_server
}

# Backend API, auth, webhooks, PgBoss-driven server
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy server:3001
}
